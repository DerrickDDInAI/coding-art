# ---------------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
**/pexels_api_key
*.pem
*credentials*.json

# ---------------------------------------------------------------------
# Assets: large, personal, and regenerable. Scripts create these folders.
# The leading ** matches at any depth (the old */assets pattern only
# matched one level down, which silently let nested assets through).
# ---------------------------------------------------------------------
**/assets/data/
**/assets/images/
**/assets/models/
**/assets/sounds/
**/assets/3d/
**/utils/face_detector/models/

# rendered output
*.mp4
*.mov
*.avi
*.gif
*.wav
*.mp3
# ...but keep anything used to illustrate the README
!docs/**/*.gif
!docs/**/*.mp4

# Blender working files
*.blend
*.blend1

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# ---------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------
.vscode/
.idea/
.DS_Store

# Claude Code local settings
.claude/settings.local.json
