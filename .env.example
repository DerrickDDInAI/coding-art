# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored; this template is not.
#
# Load it in a notebook with:
#     from dotenv import load_dotenv; load_dotenv()

# Pexels image scraping — core/utils/scraper/pexels.py
# Get a key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional. Only needed if you did NOT run `pip install -e .`; it lets Python
# find the `core` package when a notebook's working directory is `core/`.
# PYTHONPATH=.
